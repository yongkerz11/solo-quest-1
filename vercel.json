{
  "functions": {
    "app/api/push-cron/route.ts": {
      "experimentalTriggers": [
        {
          "type": "schedule/v1beta"
        }
      ]
    }
  },
  "schedules": {
    "quest-push-dispatch": {
      "schedule": "*/15 * * * *",
      "timezone": "Asia/Jakarta",
      "function": "api/push-cron"
    }
  }
}
